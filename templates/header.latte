<header class="mt-10 maw-600 mx-auto">
    <div class="float-left">
        <button id="prev" class="white bg-orange">
            <span class="bold larger">&larr;</span>
            Předchozí
        </button>
    </div>

    <div class="float-right">
        <button id="next" class="white bg-green">
            Další
            <span class="bold larger">&rarr;</span>
        </button>
    </div>

    <div class="cleaner"></div>
</header>